{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://swarm.cloud/schemas/v1alpha1/data-definition.schema.json",
  "title": "DataDefinition",
  "description": "Root schema for a Swarm Cloud Marketplace dataset definition (v1alpha1).",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "swarm.cloud/v1alpha1",
      "description": "Specification version."
    },
    "kind": {
      "type": "string",
      "const": "DataDefinition",
      "description": "Resource kind."
    },
    "metadata": {
      "$ref": "#/definitions/Metadata"
    },
    "spec": {
      "$ref": "#/definitions/Spec"
    }
  },
  "definitions": {
    "Metadata": {
      "type": "object",
      "required": ["name", "title", "description"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$",
          "description": "Unique dataset identifier. Must be lowercase alphanumeric with hyphens."
        },
        "title": {
          "type": "string",
          "description": "Human-readable display name."
        },
        "description": {
          "type": "string",
          "description": "Short description (1-2 sentences)."
        },
        "category": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "Single catalog category from the marketplace taxonomy (e.g. finance, healthcare, language)."
        },
        "icon": {
          "type": "string",
          "description": "Relative path to the icon file."
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Tags for filtering and search."
        }
      }
    },
    "Spec": {
      "type": "object",
      "required": ["provides"],
      "additionalProperties": false,
      "properties": {
        "secrets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "publisher-secret.schema.json"
          },
          "description": "Publisher secrets required by this dataset's connection resolution. Values are entered by the publishing organization at publication time and referenced via {{ secrets.<name> }}."
        },
        "provides": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/ProvidedInterface"
          },
          "description": "Data interfaces the platform can serve this dataset over."
        },
        "schema": {
          "$ref": "data-schema.schema.json",
          "description": "Semantic schema of the dataset. Datasets without a schema cannot match schema-constrained slots."
        }
      }
    },
    "ProvidedInterface": {
      "type": "object",
      "required": ["interface"],
      "additionalProperties": false,
      "properties": {
        "interface": {
          "$ref": "#/definitions/InterfaceRef"
        },
        "connection": {
          "$ref": "#/definitions/ConnectionResolution"
        }
      }
    },
    "ConnectionResolution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "static": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
          },
          "additionalProperties": {
            "type": ["string", "integer", "number", "boolean"]
          },
          "description": "Connection properties rendered once at publication. String values may interpolate {{ secrets.<name> }}. Every binding receives the same values."
        },
        "provisioner": {
          "$ref": "#/definitions/Provisioner"
        }
      },
      "oneOf": [
        { "required": ["static"] },
        { "required": ["provisioner"] }
      ],
      "description": "How the connection object for this interface is produced. The result MUST validate against the connection schema of the interface."
    },
    "Provisioner": {
      "type": "object",
      "required": ["image"],
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "string",
          "pattern": "^[^\\s@]+@sha256:[a-f0-9]{64}$",
          "description": "Digest-pinned container image executed in the platform sandbox for every binding. Sealed secrets are released only to the attested, pinned image."
        },
        "env": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string"
          },
          "description": "Environment variables passed to the provisioner. Values may interpolate {{ secrets.<name> }} and {{ binding.<field> }}."
        }
      }
    },
    "InterfaceRef": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]/v[0-9]+((alpha|beta)[0-9]+)?$",
      "description": "Reference to a DataInterface in the form <name>/<version>, e.g. clickhouse-native/v1."
    }
  }
}
