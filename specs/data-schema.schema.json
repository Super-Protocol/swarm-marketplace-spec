{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://swarm.cloud/schemas/v1alpha1/data-schema.schema.json",
  "title": "DataSchema",
  "description": "Semantic description of a dataset: tables and typed columns (the semantic layer of data compatibility).",
  "type": "object",
  "required": ["tables"],
  "additionalProperties": false,
  "properties": {
    "tables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/Table"
      },
      "description": "Tables (or table-like objects) contained in the dataset."
    }
  },
  "definitions": {
    "Table": {
      "type": "object",
      "required": ["name", "columns"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$",
          "description": "Table name as addressable through the provided interfaces."
        },
        "description": {
          "type": "string",
          "description": "Human-readable description of the table contents."
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/Column"
          },
          "description": "Ordered list of columns."
        }
      }
    },
    "Column": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$",
          "description": "Column name."
        },
        "type": {
          "$ref": "#/definitions/ColumnType"
        },
        "description": {
          "type": "string",
          "description": "Human-readable description of the column."
        },
        "nullable": {
          "type": "boolean",
          "default": false,
          "description": "Whether the column may contain null values."
        },
        "items": {
          "$ref": "#/definitions/ColumnType",
          "description": "Element type. Only valid when type is 'array'."
        },
        "dimensions": {
          "type": "integer",
          "minimum": 1,
          "description": "Vector length (e.g. 768 for an embedding column). Only valid when type is 'vector'."
        },
        "role": {
          "$ref": "#/definitions/ColumnRole"
        },
        "references": {
          "type": "string",
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*\\.[a-zA-Z_][a-zA-Z0-9_]*$",
          "description": "'<table>.<column>' within this dataset that this column points at."
        }
      }
    },
    "ColumnRole": {
      "type": "string",
      "enum": ["measure", "dimension"],
      "description": "Analytical role: 'measure' is aggregated, 'dimension' is grouped or filtered by."
    },
    "ColumnType": {
      "type": "string",
      "enum": [
        "string",
        "integer",
        "number",
        "boolean",
        "timestamp",
        "date",
        "json",
        "binary",
        "array",
        "vector"
      ],
      "description": "Canonical column type, mapped from the storage engine's native type."
    }
  }
}
