{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://swarm.cloud/schemas/v1alpha1/value-source.schema.json",
  "title": "ValueSource",
  "description": "Defines where a parameter's available options come from.",
  "type": "object",
  "required": ["source"],
  "additionalProperties": false,
  "properties": {
    "source": {
      "type": "object",
      "required": ["type"],
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "static"
            },
            "values": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/definitions/StaticOption"
              }
            }
          },
          "required": ["type", "values"],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "remote"
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "valuePath": {
              "type": "string"
            },
            "labelPath": {
              "type": "string"
            },
            "cacheTtl": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": ["type", "url", "valuePath", "labelPath"],
          "additionalProperties": false
        }
      ]
    }
  },
  "definitions": {
    "StaticOption": {
      "type": "object",
      "required": ["value", "label"],
      "additionalProperties": false,
      "properties": {
        "value": {
          "description": "The value stored when this option is selected."
        },
        "label": {
          "type": "string",
          "description": "Display text shown in the UI."
        }
      }
    }
  }
}
